// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
  extensions = [vector]
  relationMode = "prisma"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  sources       ContentSource[]
  schedules     ContentSchedule[]
  posts         GeneratedPost[]
  brands        Brand[]

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GeneratedPost {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  content    String   @db.Text
  title      String?
  published  Boolean  @default(false)
  embeddings Json?
  platform   String   @default("twitter")
  status     String   @default("draft")

  @@index([userId])
}

model ContentSource {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  url       String
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  schedules ContentSchedule[]

  @@index([userId])
}

model ScrapedContent {
  id          String        @id @default(cuid())
  content     String        @db.Text
  embedding   Unsupported("vector(1536)")  // Changed from Float[] to Unsupported
  metadata    Json?
  createdAt   DateTime      @default(now())
  sourceId    String

  @@index([embedding(type: Vector)])
}

model Brand {
  id              String    @id @default(cuid())
  brandName       String
  brandType       String
  industry        String
  language        String?
  website         String?
  brandVoice      String
  usp             String?
  missionStatement String?
  slogans         String?
  demographics    String?
  psychographics  String?
  contentThemes   String?
  primaryObjectives String?
  brandStory      String?
  embedding_1     Unsupported("vector(384)")
  embedding_2     Unsupported("vector(384)")
  embedding_3     Unsupported("vector(384)")
  embedding_4     Unsupported("vector(384)")
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([embedding_1(type: Vector)])
  @@index([embedding_2(type: Vector)])
  @@index([embedding_3(type: Vector)])
  @@index([embedding_4(type: Vector)])
}

model ContentSchedule {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  contentSourceId String
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id])
  frequency       String        @default("daily")
  time            String
  date            DateTime?
  lastRun         DateTime?
  active          Boolean       @default(true)
  platform        String        @default("twitter")
  platforms       String[]      @default([])
  tonality        String        @default("neutral")
  aiInstructions  String        @default("")
  useEmojis       Boolean       @default(false)
  recurringDays   String[]      @default([])

  @@index([userId])
  @@index([contentSourceId])
}
